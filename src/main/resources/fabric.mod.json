{
	"schemaVersion": 1,
	"id": "mcsr-practice",
	"version": "${version}",
	"name": "MCSR Practice",
	"description": "A practice mod for Minecraft Speedrunning aiming to make practice easier by introducing faster reset times and more things to practice with the click of a button",
	"authors": [
		"shaweel"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/mcsr-practice",
		"sources": "https://github.com/shaweel/MCSR-Practice"
	},
	"license": "GPL-v3",
	"icon": "assets/mcsr-practice/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.shaweel.mcsrpractice.MCSRPractice"
		]
	},
	"mixins": [
		"mcsr-practice.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.16.1",
		"java": ">=8",
		"fabric": "*"
	}
}